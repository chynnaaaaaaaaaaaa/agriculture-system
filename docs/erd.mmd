erDiagram
    FARMER ||--o{ FARM : owns
    FARM ||--o{ PLANTING : has
    CROP ||--o{ PLANTING : "is planted in"
    PLANTING ||--o{ HARVEST : yields
    SOIL_TYPE ||--o{ FARM : classifies
    IRRIGATION_TYPE ||--o{ FARM : classifies
    CROP_CATEGORY ||--o{ CROP : classifies
    SEASON ||--o{ CROP : recommended_for
    PLANTING_STATUS ||--o{ PLANTING : describes
    QUALITY_GRADE ||--o{ HARVEST : grades
    HARVEST_REMARK ||--o{ HARVEST : describes
    APP_USER ||--o{ FARMER : "created/updated by"
    FARMER { int farmer_id PK
      varchar first_name
      varchar last_name
      varchar contact_number UK
      varchar address
      date date_registered }
    FARM { int farm_id PK
      int farmer_id FK
      varchar farm_name
      varchar location
      numeric area_hectares
      int soil_type_id FK
      int irrigation_type_id FK }
    CROP { int crop_id PK
      varchar crop_name
      varchar variety
      int crop_category_id FK
      int growing_period_days
      int season_id FK }
    PLANTING { int planting_id PK
      int farm_id FK
      int crop_id FK
      date planting_date
      numeric area_planted
      numeric seed_quantity
      date expected_harvest_date
      int status_id FK }
    HARVEST { int harvest_id PK
      int planting_id FK
      date harvest_date
      numeric quantity_kg
      numeric selling_price_per_kg
      int grade_id FK
      int remark_id FK }
    SOIL_TYPE { int soil_type_id PK
      varchar soil_type_name UK }
    IRRIGATION_TYPE { int irrigation_type_id PK
      varchar irrigation_type_name UK }
    CROP_CATEGORY { int crop_category_id PK
      varchar category_name UK }
    SEASON { int season_id PK
      varchar season_name UK }
    PLANTING_STATUS { int status_id PK
      varchar status_name UK }
    QUALITY_GRADE { int grade_id PK
      varchar grade_name UK }
    HARVEST_REMARK { int remark_id PK
      varchar remark_description UK }
    APP_USER { int user_id PK
      varchar username UK
      varchar password_hash
      varchar role }
